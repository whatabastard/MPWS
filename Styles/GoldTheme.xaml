<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B89342" Offset="0"/><GradientStop Color="#9E7B2F" Offset=".64"/><GradientStop Color="#7A5C1E" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint=".28,1">
    <GradientStop Color="#F22B2C32"/><GradientStop Color="#EC1D1E23" Offset=".45"/><GradientStop Color="#EE16161B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lip" StartPoint="0,0" EndPoint=".22,1">
    <GradientStop Color="#AC987752"/><GradientStop Color="#63494036" Offset=".3"/><GradientStop Color="#18493C2C" Offset="1"/>
  </LinearGradientBrush>
  <DrawingBrush x:Key="Engraving" TileMode="Tile" Viewport="0,0,68,68" ViewportUnits="Absolute" Opacity=".16">
    <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,34 L34,0 68,34 34,68 Z M10,34 L34,10 58,34 34,58 Z M27,34 L34,27 41,34 34,41 Z">
      <GeometryDrawing.Pen><Pen Brush="#AA884F" Thickness=".7"/></GeometryDrawing.Pen>
    </GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#0B0B0E"/><Setter Property="Foreground" Value="#F3EEE3"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#C2BDB3"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="34"/><Setter Property="Foreground" Value="#F3E5C2"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity=".45"/></Setter.Value></Setter><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="BorderBrush" Value="{StaticResource Lip}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EEE4CE"/><Setter Property="Background" Value="#242326"/><Setter Property="BorderBrush" Value="#584B33"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" RenderTransformOrigin=".5,.5"><Border.RenderTransform><ScaleTransform x:Name="Zoom"/></Border.RenderTransform>
      <Grid><Border x:Name="Gleam" CornerRadius="18" Background="{StaticResource Gold}" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9E7B2F"/>
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Gleam" Storyboard.TargetProperty="Opacity" To=".28" Duration="0:0:.18"/>
          <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:.18"><DoubleAnimation.EasingFunction><CubicEase/></DoubleAnimation.EasingFunction></DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:.18"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Gleam" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:.16"/>
          <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:.16"/>
          <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:.16"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To=".96" Duration="0:0:.09"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:.32"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFF2BC"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".48"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#211B0F"/><Setter Property="Padding" Value="23,12"/></Style>
  <Style x:Key="Island" TargetType="Border"><Setter Property="CornerRadius" Value="28"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="BorderBrush" Value="{StaticResource Lip}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="6" Opacity=".8"/></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#19191E"/><Setter Property="Foreground" Value="#F3EEE3"/><Setter Property="CaretBrush" Value="#B89342"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#75613A" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#61543C" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TileGrid" TargetType="ItemsControl">
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemTemplate"><Setter.Value>
      <DataTemplate>
        <Border x:Name="TileFrame" Style="{StaticResource Panel}" Margin="3,0,7,12" Padding="16">
          <StackPanel>
            <DockPanel>
              <Path Data="{Binding Icon}" Width="25" Height="25" HorizontalAlignment="Left" Stretch="Uniform" Stroke="#B89342" StrokeThickness="1.5"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="7,3" Background="#363127">
                <TextBlock Text="{Binding Badge}" Foreground="#D3BE92" FontSize="11"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers><DataTrigger Binding="{Binding Highlight}" Value="True"><Setter TargetName="TileFrame" Property="BorderBrush" Value="#D4B46A"/><Setter TargetName="TileFrame" Property="BorderThickness" Value="2"/></DataTrigger></DataTemplate.Triggers>
      </DataTemplate>
    </Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="CategoryLabel">
    <StackPanel Orientation="Horizontal">
      <Path x:Name="Symbol" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1 H8 V8 H1 Z M12,1 H19 V8 H12 Z M1,12 H8 V19 H1 Z M12,12 H19 V19 H12 Z"/>
      <TextBlock Text="{Binding}" Margin="7,0,0,0"/>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding}" Value="CS2"><Setter TargetName="Symbol" Property="Data" Value="M10,3 A7,7 0 1 1 9.99,3 M10,0 V6 M10,14 V20 M0,10 H6 M14,10 H20"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="Dota 2"><Setter TargetName="Symbol" Property="Data" Value="M1,1 H19 V19 H1 Z M2,2 L18,18 M2,7 L13,18 M10,2 L18,10"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="Discord"><Setter TargetName="Symbol" Property="Data" Value="M1,2 H19 V14 H8 L3,18 V14 H1 Z M5,8 H7 M10,8 H12 M15,8 H16"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="Steam"><Setter TargetName="Symbol" Property="Data" Value="M2,13 L8,16 16,7 M14,2 A4,4 0 1 1 13.99,2 M6,13 A3,3 0 1 1 5.99,13"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
